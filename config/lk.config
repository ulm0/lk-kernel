# lk-kernel: one option list over 'make allnoconfig' for natkit (EC2 NAT), yagan (EC2 k3s) and limakit (Lima VM),
# both architectures; lk-<uname -m>.config adds per-architecture options (build.sh applies both, then olddefconfig).
# Anything unlisted is allnoconfig's n, or the Kconfig default if it only becomes visible here. Comments go on their
# own lines: build.sh would read a trailing one into the value. A '# uncertain:' line flags the option below it.
# Sections say which project needed an option first; the kernel has all of them.

# ======== natkit: EC2 NAT instance (hardening, netfilter/nftables, NAT64) ========

# LinuxKit kernel Dockerfile: modules_install + Module.symvers need MODULES (Jool's NAT64 modules load at boot)
CONFIG_MODULES=y
CONFIG_LOCALVERSION="-linuxkit"

# core userspace basics (most are on anyway while EXPERT=n; listed so a dropped one fails the build check)
CONFIG_EXPERT=n
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# timers: hrtimers for nanosleep/timerfd; tickless idle
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# UEFI boot (systemd-boot + a UKI, LinuxKit's raw-efi), hardware described by ACPI on both EC2 architectures
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_DMIID=y
# the root filesystem is LinuxKit's gzip initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# PCIe: Nitro attaches ENIs (the static ENI, eni_id) and EBS volumes at runtime by PCIe hotplug
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y

# EBS (the root volume) is NVMe
CONFIG_BLOCK=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EFI_PARTITION=y

# ENA network interface
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_WLAN=n

# serial console (EC2 console output, the serial console getty)
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# rngd
CONFIG_HW_RANDOM=y

# clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_HCTOSYS=y

# instance stop/terminate: ACPI power button -> evdev -> acpid
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y
CONFIG_KEYBOARD_ATKBD=n
CONFIG_USB_SUPPORT=n

# pseudo filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n
CONFIG_UEVENT_HELPER=n
# containerd's snapshotter (the CloudWatch agent, pulled at boot when enabled)
CONFIG_OVERLAY_FS=y

# namespaces: LinuxKit services (runc needs /proc/self/setgroups, which only exists with user namespaces)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_TIME_NS=n

# seccomp: dhcpcd privsep
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# cgroup v2 for containerd/runc; device control through BPF
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# networking core
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y
CONFIG_IPV6_SIT=n
CONFIG_PACKET=y
CONFIG_WIRELESS=n

# the NAT: conntrack + nftables masquerade (init/natkit-init), IPv4 and IPv6 tables.
# NETFILTER_ADVANCED=y keeps the unlisted netfilter options n instead of their default m.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# Jool (NAT64): its netfilter hooks come after IPv4/IPv6 defragmentation; it also builds an iptables target (x_tables)
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XTABLES=y
# Jool hashes with MD5 through the crypto API to pick source ports (RFC 6056); without it the module doesn't link,
# and without the md5 algorithm it wouldn't initialize
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MD5=y

# hardening. allnoconfig turns every one of these off, the CPU vulnerability mitigations included.
CONFIG_CPU_MITIGATIONS=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# no /dev/mem, no kexec, no 32-bit or legacy syscall surface (all n under allnoconfig; listed so they stay n)
CONFIG_DEVMEM=n
CONFIG_KEXEC=n
CONFIG_COMPAT=n

# ======== yagan: containers, k3s, Cilium, EC2 ========

CONFIG_CROSS_MEMORY_ATTACH=n
CONFIG_CHECKPOINT_RESTORE=n

CONFIG_BINFMT_MISC=y

# virtio over PCI (modern only)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
# uncertain: VZ balloon present; free page reporting gives memory back to macOS, boots without it
CONFIG_VIRTIO_BALLOON=y

CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# data lives on /dev/loop0, a window onto /dev/vda after the squashfs root mounted from the same disk
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_MSDOS_PARTITION=y

CONFIG_VIRTIO_CONSOLE=y

CONFIG_HW_RANDOM_VIRTIO=y

CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_GPIOLIB=y

# root filesystem: squashfs (gzip) is under the MISC_FILESYSTEMS menu
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
# LinuxKit's squashfs carries xattrs (file capabilities); without this they are silently dropped
CONFIG_SQUASHFS_XATTR=y

# data disk + additionalDisks: ext4 (default), xfs (v5 only), btrfs
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_XFS_SUPPORT_V4=n
CONFIG_XFS_SUPPORT_ASCII_CI=n
CONFIG_BTRFS_FS=y
# uncertain: only for additionalDisks fsType swap (and docker --memory-swap); no swap in the image
CONFIG_SWAP=y

# Lima cidata ISO (Rock Ridge only)
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=n
CONFIG_ZISOFS=n

# virtiofs mounts + Rosetta share, reverse-sshfs (/dev/fuse)
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# THP: linuxkit/sysfs writes transparent_hugepage/* and log.Fatal's on a missing path
CONFIG_TRANSPARENT_HUGEPAGE=y

CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
# v1 controller symbols k3s' check-config requires (kubelet on cgroup v2 still probes them)
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y

# guestagent eBPF port ticker: tracepoint syscalls:sys_exit_bind via perf_event_open (tracefs from FTRACE_SYSCALLS; UPROBE_EVENTS satisfies BPF_EVENTS)
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# uncertain: optional, the interpreter runs the ticker and runc device filter fine
CONFIG_BPF_JIT=y

# guestagent port discovery: netlink sock_diag for TCP and UDP (UDP forwarding silently breaks without it)
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y

CONFIG_VIRTIO_NET=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=n

# vsock: guestagent <-> hostagent, ssh over vsock (socat VSOCK-LISTEN)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=n
CONFIG_VSOCKETS_LOOPBACK=n

CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
# xt_addrtype (and other xt matches) register their IPv6 variant only with IP6_NF_IPTABLES, even under nft:
# without it dockerd can't set up its ip6tables chains
CONFIG_IP6_NF_IPTABLES=y

# nestedVirtualization: /dev/kvm in the guest (VHE), docker --device /dev/kvm
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y

# k3s / k3d (Kubernetes in docker): k3s contrib/util/check-config.sh's required list, plus what its defaults use:
# kube-proxy (iptables: MARK, REJECT, comment, multiport, statistic; iptables-nft may emit native ct/limit/reject),
# flannel (VXLAN), the network-policy controller (ipset, set match, limit, NFLOG)
# 6.18+: the legacy (non-nft) iptables tables are behind these
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_VXLAN=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Cilium (docs.cilium.io system requirements): base (tc BPF, BTF, schedstats), tunnels (VXLAN above, GENEVE,
# FIB rules), iptables masquerading (ipset/comment above), L7/FQDN policies (TPROXY, socket/mark/CT),
# bandwidth manager (fq). BTF needs debug info + pahole at build time (build.sh).
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHEDSTATS=y
CONFIG_CRYPTO_SHA1=y
CONFIG_GENEVE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
# Cilium's netlink library opens every family it knows; without the XFRM one the agent fails to start
# ('protocol not supported')
CONFIG_XFRM_USER=y
# Cilium's start-up requirements (pkg/datapath/linux/requirements.go): bpf_get_cgroup_classid()
CONFIG_CGROUP_NET_CLASSID=y

# AWS VPC CNI + Cilium chaining (cni.chainingMode=aws-cni): aws-node keeps its connmark rules in mangle and
# Cilium adds raw-table chains, through iptables-legacy or -nft. Built in, not modules: no modprobe in k3s.
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_FILTER=y

# Tailscale (userspace WireGuard over TUN, above): subnet routers/exit nodes masquerade over IPv4 and IPv6 and clamp
# TCP MSS in mangle (iptables mode); nftables mode uses masq in ip/ip6/inet tables.
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# typical cluster addons
# Cilium's base requirements (docs.cilium.io "System Requirements"): AF_ALG hashing
CONFIG_CRYPTO_USER_API_HASH=y
# EFS CSI: efs-utils mounts NFSv4.1 (through a TLS tunnel in its pod)
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
# Cilium transparent encryption (encryption.type=wireguard), Tailscale's kernel mode
CONFIG_WIREGUARD=y
# NodeLocal DNSCache binds its address to a dummy interface
CONFIG_DUMMY=y
# kubelet/cAdvisor pressure (PSI) metrics; pod hugepages (hugepages-2Mi resources)
CONFIG_PSI=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
# eBPF observability/security agents (Tetragon, Inspektor Gadget, Datadog, bpftrace) attach kprobes; per-cgroup perf
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_CGROUP_PERF=y
# /proc/config.gz: agents and kube-bench check kernel features from it
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Cilium bandwidth manager's BBR (bandwidthManager.bbr)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# nftables expressions: AWS VPC CNI's connmark chains use fib (without it ipamd fails with NFT_MSG_NEWRULE ENOENT);
# kube-proxy's nftables mode load-balances with numgen and hash; transparent proxies (service meshes) redirect
# with redir/tproxy/socket
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_LOG=y
