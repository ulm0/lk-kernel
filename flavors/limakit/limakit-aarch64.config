# limakit kernel options for arm64 (Lima on Apple silicon, VZ), after limakit.config (build.sh)

# VZLinuxBootLoader direct boot: DT only, no EFI/ACPI (EFI=n also keeps EFI_ZBOOT off, so the build produces Image.gz)
CONFIG_ACPI=n
CONFIG_EFI=n

# arm64 CPU features allnoconfig drops (hardening/perf on M4)
# uncertain: hardening only, not needed to boot
CONFIG_ARM64_PAN=y
# uncertain: performance only (LL/SC fallback works)
CONFIG_ARM64_USE_LSE_ATOMICS=y

# PCI: ECAM host bridge, MSI-X via GICv2m
CONFIG_PCI_HOST_GENERIC=y

# clock: VZ's PL031 RTC; limactl stop: VZ power button = PL061 GPIO -> gpio-keys
CONFIG_RTC_DRV_PL031=y
CONFIG_GPIO_PL061=y
