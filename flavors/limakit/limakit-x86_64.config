# limakit kernel options for x86_64 (Lima on an Intel Mac or Linux: QEMU or VZ), after limakit.config (build.sh)
# uncertain: limakit on x86_64 has not been booted yet, and limakit itself only builds an arm64 image today

# direct kernel boot (no EFI); x86 VMs describe their hardware (PCIe ECAM, power button) with ACPI
CONFIG_EFI=n
CONFIG_ACPI=y
# limactl stop: ACPI power button -> evdev -> acpid
CONFIG_ACPI_BUTTON=y

# SMP and KVM paravirt guest support (QEMU/KVM and HVF expose the KVM interface)
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y

# no 32-bit syscalls
CONFIG_IA32_EMULATION=n

# clock: CMOS RTC
CONFIG_RTC_DRV_CMOS=y

# serial console for QEMU (VZ uses hvc0, virtio-console)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
