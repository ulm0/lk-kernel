# yagan kernel options for arm64 (Lima/VZ heritage + EC2 Graviton), after yagan.config (build.sh)

# arm64 CPU features allnoconfig drops
# uncertain: hardening only, not needed to boot
CONFIG_ARM64_PAN=y
# uncertain: performance only (LL/SC fallback works)
CONFIG_ARM64_USE_LSE_ATOMICS=y

# PCI: ECAM host bridge
CONFIG_PCI_HOST_GENERIC=y

# VZ's PL031 RTC and PL061 GPIO (power button -> gpio-keys); kept from limakit
CONFIG_RTC_DRV_PL031=y
CONFIG_GPIO_PL061=y

# the UKI needs an uncompressed PE kernel (EFI_STUB, `linuxkit build --decompress-kernel`), not EFI_ZBOOT
CONFIG_EFI_ZBOOT=n

# interrupts: GICv3 with ITS for PCIe MSI-X (VZ uses GICv2 + GICv2m)
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y

# uncertain: Graviton's UART type (16550-compatible vs PL011); both are enabled
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
