# yagan kernel options for EC2 x86_64 (Nitro), after yagan.config (build.sh). Same platform base as
# natkit-x86_64.config, which is boot-tested on t3 instances.
# uncertain: yagan on x86_64 has not been booted yet

# SMP, and the KVM paravirt guest support Nitro instances use (pvclock, PV spinlocks/TLB flush)
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y

# no 32-bit syscalls (yagan runs 64-bit containers only), no 32-bit EFI firmware
CONFIG_IA32_EMULATION=n
CONFIG_EFI_MIXED=n

# serial console: Nitro's 16550 UART, enumerated through ACPI PNP
CONFIG_PNP=y
CONFIG_SERIAL_8250_PNP=y

# clock: CMOS RTC
CONFIG_RTC_DRV_CMOS=y

# KASLR needs a relocatable kernel
CONFIG_RELOCATABLE=y
